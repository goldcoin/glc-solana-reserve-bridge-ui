# =============================================================================
# Goldcoin Solana Reserve Bridge UI — environment
# =============================================================================
# EVERY variable here is PUBLIC and is shipped to the browser.
#
# This frontend contains NO secrets. Never add a signer endpoint, custody
# credential, admin/operator API, private key, or TLS material to this file or
# to any environment this app runs in. `npm run check:env` fails the build if a
# variable name looks like a secret, and it runs in CI on every push.
#
# No domain is hardcoded anywhere in the source. Every URL the UI renders or
# calls originates here.
# =============================================================================

# --- Application identity ----------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated list of every domain that is officially the bridge.
# Rendered verbatim on /verify and in the footer. Anything not listed is a scam.
NEXT_PUBLIC_OFFICIAL_DOMAINS=localhost

# Build version, included in the support diagnostic bundle. Unset omits the line.
NEXT_PUBLIC_APP_VERSION=

# --- Bridge API --------------------------------------------------------------
# "mock" serves typed in-repo fixtures and makes zero network calls.
# "http" talks to NEXT_PUBLIC_BRIDGE_API_URL.
NEXT_PUBLIC_BRIDGE_API_MODE=mock

# Only read in mock mode. Which unhappy path the mock client simulates —
# used by E2E tests to exercise a paused direction or exhausted reserve
# capacity against a real running server without a live backend.
# One of: operational | paused | insufficient-liquidity
NEXT_PUBLIC_MOCK_SCENARIO=operational

# Base URL of the reserve bridge's off-chain HTTP API (service/src/api.rs in
# glc-solana-reserve-bridge). That service ships with NO auth, NO CORS and NO
# TLS of its own — deploy it behind a reverse proxy and put that proxy's
# public origin here, never the bare daemon port on an untrusted network.
# Required when NEXT_PUBLIC_BRIDGE_API_MODE=http.
NEXT_PUBLIC_BRIDGE_API_URL=

# LOCAL DEVELOPMENT ONLY. The real backend sets no CORS headers (by design —
# it expects a reverse proxy in front of it, see the note above), so a
# browser cannot fetch it directly from a different origin. Setting
# NEXT_PUBLIC_BRIDGE_API_URL to this app's own "/api/bridge" and pointing
# THIS variable at the real backend's bare address routes every request
# through app/api/bridge/[...path]/route.ts instead — same-origin from the
# browser's point of view, forwarded server-side to the real backend. Unused
# and safe to leave blank outside local development; never set in production.
NEXT_PUBLIC_BRIDGE_API_PROXY_UPSTREAM_URL=

# --- Solana ------------------------------------------------------------------
# One of: mainnet-beta | testnet | devnet | localnet
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Solana RPC endpoint used for wallet balances and for the browser's own
# wallet-adapter calls (sendTransaction/getLatestBlockhash/
# confirmTransaction) when building the Solana -> Goldcoin deposit
# transaction. This is called directly from the user's browser, not from
# a server, so it must be an endpoint that actually accepts browser-origin
# traffic at production volume.
#
# For NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta: do NOT use Solana Labs'
# public shared endpoint (https://api.mainnet-beta.solana.com) — it is
# free, unauthenticated, and explicitly not for production use; it heavily
# rate-limits and, in practice, outright rejects (403) many browser-origin
# requests. Startup validation refuses this value on mainnet-beta for
# exactly that reason. Use a dedicated RPC provider (a paid plan from
# Helius/Triton/QuickNode/Alchemy or equivalent, or your own node) instead.
#
# For testnet/devnet/localnet, the corresponding public cluster endpoint
# (e.g. https://api.devnet.solana.com) is the normal, supported choice.
NEXT_PUBLIC_SOLANA_RPC_URL=

# Canonical Solana GLC mint (Token-2022, 6 decimals). Defaults to the
# published canonical mint if unset:
#   Hn6Kdxs6cJrXDLvArAief8ueTgdZLkRacLPPUZo2pump
NEXT_PUBLIC_RESERVE_MINT_ADDRESS=Hn6Kdxs6cJrXDLvArAief8ueTgdZLkRacLPPUZo2pump

# The reserve bridge's on-chain Anchor program id (glc-reserve-bridge),
# used to build the Solana -> Goldcoin `deposit_to_reserve` instruction
# client-side — there is no backend endpoint for that direction; the user's
# wallet submits this instruction directly.
#
# IMPORTANT: the id below (when set) must point at a real deployment of the
# program for the target NEXT_PUBLIC_SOLANA_CLUSTER. While this is unset,
# the Solana -> Goldcoin direction disables with a stated reason rather
# than the UI guessing a program id.
#
# Current PRODUCTION (mainnet-beta) deployment, per bridge operations
# (2026-08-21):
#   6tmLSP2j2thito2RpByqgfKHuVRSLcNd9c5FkrLJMjja
#
# Two ids are permanently RETIRED and refused by startup validation when
# the cluster is mainnet-beta (mirroring the backend's own denylist in
# glc-solana-reserve-bridge: service/src/bin/glc-mainnet-bootstrap.rs and
# scripts/verify-program-id-replacement.sh):
#   BnCFcMaZtpXUzZhXZdQSeQWH4A2BMv5ZaebGe6Ysv2oY  (scaffold/dev id — still
#     what local validators deploy at for development; never deployed to a
#     public cluster)
#   7h2zSJuqpmbSq4seeXDdaJChVoxhEWwA9b8qG6Ct1GNn  (first mainnet
#     deployment, permanently closed with its rent reclaimed)
NEXT_PUBLIC_RESERVE_PROGRAM_ID=

# --- Robinhood Network (EVM) --------------------------------------------------
# The Robinhood -> Goldcoin route has no backend create endpoint, exactly like
# Solana -> Goldcoin: the depositor's own wallet calls the GlcRobinhoodBridge
# custody contract's `deposit()` and the bridge's indexer folds the resulting
# on-chain obligation. These five values are what building that call needs.
#
# ALL OF THEM ARE UNSET, AND CORRECTLY SO. The custody contract is NOT
# DEPLOYED: its address, its EIP-155 chain id and its indexer start block are
# recorded as unknown in the backend's own docs/32-robinhood-settlement-phase-f.md.
# While any of them is missing, the deposit action refuses with a stated reason
# instead of building a transaction — the same fail-closed rule
# NEXT_PUBLIC_RESERVE_PROGRAM_ID already applies to the Solana deposit.
#
# There is no default and no fallback for any of these anywhere in the code. A
# guessed chain id signs for the wrong network and a guessed contract address
# sends real GLC somewhere that is not the bridge; neither failure is visible
# until after the user has signed.
#
# Setting them does NOT open the route. Route availability comes from
# GET /chains alone — the backend's RouteGate plus the contract's own
# routeEnabled — and both Robinhood routes ship disabled.

# Decimal EIP-155 chain id. DECIMAL, never hex: 4663 and 0x4663 are different
# chains, so a hex value here would sign for the wrong network.
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=

# Display name, used in wallet prompts ("Switch to ...") and copy.
NEXT_PUBLIC_ROBINHOOD_CHAIN_NAME=

# JSON-RPC endpoint. Preflight reads (route liveness, contract limits, token
# decimals, balance, allowance) go here rather than to the wallet's own node,
# so the answers that gate a signature come from the configured endpoint.
NEXT_PUBLIC_ROBINHOOD_RPC_URL=

# The GlcRobinhoodBridge custody contract, 0x-prefixed 20-byte address.
NEXT_PUBLIC_ROBINHOOD_BRIDGE_ADDRESS=

# The ERC-20 GLC token that contract holds. Must be the token the contract
# itself reports from token(); a mismatch is refused at preflight, because an
# approval would otherwise be granted on a token the contract never pulls.
NEXT_PUBLIC_ROBINHOOD_TOKEN_ADDRESS=

# Explorer link templates, {value} placeholder. Unset means transaction ids
# render as plain text rather than as links to a guessed explorer.
NEXT_PUBLIC_ROBINHOOD_EXPLORER_TX_URL=
NEXT_PUBLIC_ROBINHOOD_EXPLORER_ADDRESS_URL=

# --- Goldcoin ----------------------------------------------------------------
# Public Goldcoin RPC, used only for explorer link building / diagnostics —
# the bridge API remains authoritative for confirmation counts and reserve
# state.
NEXT_PUBLIC_GOLDCOIN_RPC_URL=

# Base58check address version byte(s) this deployment accepts as a valid
# Goldcoin payout destination, comma separated, as decimals.
#
# Deliberately configuration rather than a constant in the code. A wrong
# version byte either rejects valid addresses or accepts addresses on the
# wrong network, and both cost the user their funds. While this is unset,
# Goldcoin address validation reports itself unavailable and the
# Solana -> Goldcoin action is disabled — it never falls back to a guess.
#
# Real, node-verified values (glc-solana-reserve-bridge:
# service/src/goldcoin/address.rs — verified against a real goldcoind,
# both networks):
#   mainnet-beta:        32   (P2PKH, "E" prefix)
#   testnet / localnet:  111  (P2PKH, "m"/"n" prefix)
#
# Use ONLY the P2PKH byte for NEXT_PUBLIC_SOLANA_CLUSTER's matching
# network — never also add the P2SH byte (50 mainnet / 58 testnet): the
# backend's Solana -> Goldcoin payout (service/src/signing/goldcoin_
# vault.rs) only ever builds a P2PKH destination output, so a P2SH
# address would pass this check and then fail deep in payout signing
# instead of being refused here, upfront, with a clear reason.
NEXT_PUBLIC_GLC_ADDRESS_VERSIONS=

# Bech32 human-readable part, if this chain has segwit addresses. Leave unset
# if it does not.
NEXT_PUBLIC_GLC_BECH32_HRP=

# --- Explorer link templates -------------------------------------------------
# {value} is replaced with the txid / address / signature.
NEXT_PUBLIC_GLC_EXPLORER_TX_URL=
NEXT_PUBLIC_GLC_EXPLORER_ADDRESS_URL=
NEXT_PUBLIC_SOLANA_EXPLORER_TX_URL=
NEXT_PUBLIC_SOLANA_EXPLORER_ADDRESS_URL=

# --- Outbound reference links ------------------------------------------------
NEXT_PUBLIC_PROTOCOL_REPO_URL=
NEXT_PUBLIC_DOCS_URL=
NEXT_PUBLIC_AUDITS_URL=
NEXT_PUBLIC_BUG_BOUNTY_URL=
NEXT_PUBLIC_SUPPORT_URL=

# NOTE: transfer limits, the bridge fee (fixed at 1% server-side), reserve
# capacity, and direction pause state are NOT configured here. They are
# served by the bridge API (GET /limits, GET /status, GET /stats) so the UI
# can never drift from protocol truth. The UI must never compute or override
# an authoritative settlement value itself.
